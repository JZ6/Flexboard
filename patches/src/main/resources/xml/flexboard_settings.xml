<?xml version="1.0" encoding="utf-8"?>
<!--
  Flexboard's settings screen, inflated by Gboard's own settings host when the header row on the
  root settings screen is tapped (the row's android:fragment names the extension fragment that
  returns this resource's runtime id).

  Rows are Gboard's own InlineSliderPreference — the widget the Morse-keyboard screen uses. Two
  things are why:

  - It reads its configuration by literal attribute name with a null namespace (slider_min_value,
    slider_max_value, slider_scale, slider_display_scale, slider_unit, slider_text_left,
    slider_text_right), so no new attribute resources are needed and aapt2 has nothing to link.
  - It persists an integer-as-string (scale defaults to 1.0) through the PreferenceDataStore that
    Gboard's fragment-lifecycle hook installs on every hosted fragment, which lands the value in
    the same store the scrub patch reads with the store's string-parsing getInt.

  The keys, defaults and bounds below are mirrored by constants in ScrubTuningPatch.kt, and
  .github/scripts/check_shared_constants.py fails the build when the two drift. There is no
  android:defaultValue more native than these literals: Gboard's own binaries carry that
  attribute under the res/android namespace the same way.
-->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="Flexboard">

    <PreferenceCategory android:title="Swipe to delete">

        <com.google.android.libraries.inputmethod.preferencewidgets.InlineSliderPreference
            android:key="flexboard_swipe_max_words"
            android:title="Words per swipe"
            android:summary="The most one swipe can delete. Swiping back always restores them."
            android:defaultValue="1"
            slider_min_value="1"
            slider_max_value="10"
            slider_text_left="1"
            slider_text_right="No limit" />

        <com.google.android.libraries.inputmethod.preferencewidgets.InlineSliderPreference
            android:key="flexboard_swipe_hold_ms"
            android:title="Hold delay"
            android:summary="How long the first key is held before the gesture counts as a swipe."
            android:defaultValue="0"
            slider_min_value="0"
            slider_max_value="300"
            slider_unit="ms" />

    </PreferenceCategory>

    <PreferenceCategory android:title="Hotkeys">

        <!--
          No count slider by design: a slot appears when its text is set (the gate is read at
          toolbar build time) and clears take effect on the next keyboard start — the registry
          has no mid-session un-register, and a lagging label is simpler than one.
        -->
        <!--
          The whole hotkey state serialized as one pasteable string, refreshed by the extension
          whenever the toolbar rebuilds. Paste an export to import it; anything that is not an
          export is replaced by one on the spot.
        -->
        <androidx.preference.EditTextPreference
            android:key="flexboard_hotkey_blob"
            android:title="Import / export"
            android:summary="One line per slot: number, text, icon. Paste an export here to import it." />

        <!--
          One plain text row per slot: what the tap commits. The EditTextPreference widget is
          bundled by Gboard's androidx port, so the dialog is stock. A slot with no text passes
          no shown-gate at toolbar build time, so blank rows simply don't render.
        -->
        <androidx.preference.EditTextPreference
            android:icon="@drawable/flexboard_icon_alternate_email"
            android:key="flexboard_hotkey_1_text"
            android:title="Hotkey 1" />
        <androidx.preference.EditTextPreference
            android:icon="@drawable/flexboard_icon_password"
            android:key="flexboard_hotkey_2_text"
            android:title="Hotkey 2" />
        <androidx.preference.EditTextPreference
            android:icon="@drawable/flexboard_icon_phone_enabled"
            android:key="flexboard_hotkey_3_text"
            android:title="Hotkey 3" />
        <androidx.preference.EditTextPreference
            android:icon="@drawable/flexboard_icon_local_post_office"
            android:key="flexboard_hotkey_4_text"
            android:title="Hotkey 4" />
        <androidx.preference.EditTextPreference
            android:icon="@drawable/flexboard_icon_home_pin"
            android:key="flexboard_hotkey_5_text"
            android:title="Hotkey 5" />
        <androidx.preference.EditTextPreference
            android:icon="@drawable/flexboard_icon_work"
            android:key="flexboard_hotkey_6_text"
            android:title="Hotkey 6" />
        <androidx.preference.EditTextPreference
            android:icon="@drawable/flexboard_icon_favorite"
            android:key="flexboard_hotkey_7_text"
            android:title="Hotkey 7" />
        <androidx.preference.EditTextPreference
            android:icon="@drawable/flexboard_icon_kid_star"
            android:key="flexboard_hotkey_8_text"
            android:title="Hotkey 8" />
        <androidx.preference.EditTextPreference
            android:icon="@drawable/flexboard_icon_credit_card"
            android:key="flexboard_hotkey_9_text"
            android:title="Hotkey 9" />
        <androidx.preference.EditTextPreference
            android:icon="@drawable/flexboard_icon_hexagon"
            android:key="flexboard_hotkey_10_text"
            android:title="Hotkey 10" />
        <androidx.preference.EditTextPreference
            android:icon="@drawable/flexboard_icon_hive"
            android:key="flexboard_hotkey_11_text"
            android:title="Hotkey 11" />
        <androidx.preference.EditTextPreference
            android:icon="@drawable/flexboard_icon_sports_soccer"
            android:key="flexboard_hotkey_12_text"
            android:title="Hotkey 12" />

    </PreferenceCategory>

    <PreferenceCategory android:title="About">

        <!--
          A disabled plain Preference carrying just the bundle version for reference. The
          placeholder is filled in by the patch before the file is written; the text comes from
          gradle.properties through flexboard_version.txt, baked by :patches:processResources.
        -->
        <Preference
            android:icon="@drawable/flexboard_settings_icon"
            android:persistent="false"
            android:selectable="false"
            android:title="Flexboard @FLEXBOARD_VERSION@" />

    </PreferenceCategory>

</PreferenceScreen>
