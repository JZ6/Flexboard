<?xml version="1.0" encoding="utf-8"?>
<!--
  The ids Flexboard admits into Gboard's toolbar. One string per admitted access-point id, and
  the string VALUE is the id itself on purpose: the runtime set is built from values, the
  encoder needs names, and keeping them identical makes both directions a no-op lookup.

  wired into res/values/strings.xml by ToolbarSlotsPatch, which then appends @string refs of
  these names into the allowed-set array. Nothing here renders unless a patch also registers a
  matching access point. Admission without registration is inert by Gboard's own design
  (docs/toolbar-access-points.md).
-->
<resources>
    <string name="flexboard_hotkey_1" translatable="false">flexboard_hotkey_1</string>
    <string name="flexboard_hotkey_2" translatable="false">flexboard_hotkey_2</string>
    <string name="flexboard_hotkey_3" translatable="false">flexboard_hotkey_3</string>
    <string name="flexboard_hotkey_4" translatable="false">flexboard_hotkey_4</string>
    <string name="flexboard_hotkey_5" translatable="false">flexboard_hotkey_5</string>
    <string name="flexboard_hotkey_6" translatable="false">flexboard_hotkey_6</string>

    <!--
      The text action buttons. These used to squat on three access-point ids that Gboard ships in
      its allowed set but never registers a handler for: editor_info, undo_cooperative and
      muse_toggle_playground_ap. That worked, and depended on Google leaving all three dormant in
      a build nobody here controls; the day one of them becomes real, our button clobbers its
      entry in the controller's map rather than failing a patch assertion. Minting our own costs
      three array members and removes the bet.
    -->
    <string name="flexboard_select_all" translatable="false">flexboard_select_all</string>
    <string name="flexboard_copy" translatable="false">flexboard_copy</string>
    <string name="flexboard_paste" translatable="false">flexboard_paste</string>
</resources>
