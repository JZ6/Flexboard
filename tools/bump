#!/usr/bin/env bash
#
# Cut a release by bumping the version.
#
#   tools/bump 1.0.1-dev.1
#
# Edits the version in gradle.properties, shows what will be published, and — once you agree —
# commits and pushes. CI takes it from there: it sees a version with no matching tag, builds the
# bundle, writes patches-bundle.json, tags, and publishes.
#
# The checks below are the same ones CI runs, via .github/scripts/check_version.sh. They are
# repeated here for one reason: the push is the point of no return. Failing in two seconds on your
# machine beats failing three minutes later with a commit already on the branch.

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

VERSION="${1:-}"
if [ -z "$VERSION" ]; then
    printf 'usage: tools/bump <version>    e.g. tools/bump 1.0.1-dev.1\n' >&2
    printf 'currently: %s\n' "$(sed -nE 's/^version *= *(.+)$/\1/p' gradle.properties)" >&2
    exit 2
fi

BRANCH=$(git rev-parse --abbrev-ref HEAD)

# A dirty tree means CI would build something other than what you have in front of you.
if [ -n "$(git status --porcelain)" ]; then
    printf 'error: working tree is not clean. Commit or stash first.\n' >&2
    git status --short >&2
    exit 1
fi

# Fetch tags before validation so a CI-created tag that is missing locally cannot be reused.
git fetch --quiet --tags origin "+refs/heads/$BRANCH:refs/remotes/origin/$BRANCH"
.github/scripts/check_version.sh "$VERSION" "$BRANCH"

# CI's release commit commonly leaves a local checkout behind origin. Require an exact tip, not
# merely "nothing unpushed", or this script makes a bump commit and the push rejects it afterwards.
if [ "$(git rev-parse HEAD)" != "$(git rev-parse "origin/$BRANCH")" ]; then
    printf 'error: %s is not at origin/%s. Pull or push before releasing.\n' "$BRANCH" "$BRANCH" >&2
    git --no-pager log --oneline --left-right "origin/$BRANCH...HEAD" >&2
    exit 1
fi

CURRENT=$(sed -nE 's/^version *= *(.+)$/\1/p' gradle.properties)
if [ "$BRANCH" = "main" ]; then
    PREVIOUS=$(git describe --tags --abbrev=0 --exclude='*-dev.*' --exclude='*-beta.*' --exclude='*-rc.*' --exclude='*-alpha.*' --exclude='*-preview.*' 2>/dev/null || true)
else
    PREVIOUS=$(git describe --tags --abbrev=0 2>/dev/null || true)
fi
if [ "$BRANCH" = "dev" ]; then CHANNEL="pre-release"; else CHANNEL="stable"; fi

printf '\n'
printf '  %-12s %s -> %s\n' "version" "$CURRENT" "$VERSION"
printf '  %-12s %s (%s)\n'  "branch"  "$BRANCH" "$CHANNEL"
printf '  %-12s %s\n'       "tag"     "v$VERSION"
printf '  %-12s https://github.com/%s/releases/download/v%s/patches-%s.mpp\n' \
    "download" "$(git remote get-url origin | sed -E 's#.*github\.com[:/]##; s#\.git$##')" "$VERSION" "$VERSION"
printf '\n  including:\n'
if [ -n "$PREVIOUS" ]; then
    git --no-pager log --max-count=20 --no-merges --format='    %s' "$PREVIOUS..HEAD"
else
    git --no-pager log --no-merges --format='    %s' -10
fi
printf '\n'

read -r -p "Release this? [y/N] " reply
case "$reply" in
    [yY]) ;;
    *) printf 'Nothing changed.\n'; exit 0 ;;
esac

sed -i.bak -E "s/^version *=.*/version = $VERSION/" gradle.properties && rm -f gradle.properties.bak
sed -i.bak -E "s/^# chore: bump to .*/# chore: bump to $VERSION/" gradle.properties && rm -f gradle.properties.bak
git add gradle.properties
git commit -F- <<EOF
chore: bump to $VERSION
EOF
git push origin "$BRANCH"

printf '\nPushed. CI is building v%s; check its Actions run URL.\n' "$VERSION"
