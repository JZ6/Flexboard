#!/bin/sh
# Flexboard pre-push gate.
#
# Delegates to tools/gate, which owns the list of lanes. It used to keep its own copy of that
# list, and the copy drifted: the hook ran three CI scripts plus preflight and never ran
# check_patch_resources.py, the one lane that looks at what the bundle produces rather than at the
# stock APK. On 2026-09-02 a malformed values fragment shipped through that gap and took every
# Flexboard button off the toolbar. Two lists meant one of them was wrong; now there is one.
#
# CI cannot run preflight or the resource lane -- both need the Gboard APK, which is gitignored
# and cannot be redistributed -- so those pins are a local gate. tools/gate reports them as SKIP
# rather than passing quietly when the APK is absent, because a skipped check that looks green is
# the thing being avoided.
#
# Install:  git config core.hooksPath tools/hooks

set -eu

root=$(git rev-parse --show-toplevel)
cd "$root"

head=$(git rev-parse HEAD)
while read -r local_ref local_sha remote_ref remote_sha; do
    # Git passes each pushed ref on stdin. A tag can be annotated, so peel it to the commit the
    # gate would need to test. A deletion has no source tree and needs no build verification.
    case "$local_sha" in
        0000000000000000000000000000000000000000) continue ;;
    esac
    target=$(git rev-parse "$local_sha^{commit}" 2>/dev/null) || {
        printf 'pre-push: cannot resolve %s to a commit\n' "$local_ref" >&2
        exit 1
    }
    if [ "$target" != "$head" ]; then
        printf 'pre-push: %s pushes %s but the gate would inspect HEAD %s; check out the pushed ref first\n' \
            "$local_ref" "$target" "$head" >&2
        exit 1
    fi
done

if [ -n "$(git status --porcelain)" ]; then
    printf 'pre-push: working tree is dirty; the gate would inspect changes not being pushed\n' >&2
    git status --short >&2
    exit 1
fi

echo "pre-push: running tools/gate"
exec tools/gate
