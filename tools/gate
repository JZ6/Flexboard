#!/bin/sh
# Flexboard's gate. One command, every lane, honest about what did not run.
#
# This exists because "the gate" used to be a list reassembled from memory at each call site, and
# on 2026-09-02 the list came up one lane short. check_patch_resources.py -- the only check that
# looks at what the bundle *produces* rather than at the stock APK -- was left out, and a malformed
# values fragment took every Flexboard button off the toolbar while "263/263 passed" scrolled by.
# See "A green gate that was not a gate" in docs/development.md.
#
# So: the set of lanes lives here, in one place, and a lane that does not run says SKIP rather
# than passing quietly.
#
#   tools/gate                  every lane
#   tools/gate --no-resources   skip the slow arsclib rebuild, and say so in the summary
#
# Exit status is non-zero if any lane FAILED. A SKIP is not a failure -- CI legitimately cannot
# run the two lanes that need the Gboard APK -- but it is never reported as a pass.

set -eu

root=$(git rev-parse --show-toplevel)
cd "$root"

run_resources=1
for arg in "$@"; do
    case "$arg" in
        --no-resources) run_resources=0 ;;
        -h|--help) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "gate: unknown option $arg" >&2; exit 2 ;;
    esac
done

results=""
failed=0
skipped=0

record() { results="${results}${1}\t${2}\n"; }

lane() {
    name=$1
    shift
    printf '\n=== %s ===\n' "$name"
    if "$@"; then
        record "$name" PASS
    else
        record "$name" FAIL
        failed=$((failed + 1))
    fi
}

# A lane that passes when the command *fails*. For checks whose whole point is that something is
# refused: a guard that is never seen to fire is indistinguishable from a guard that has quietly
# stopped firing, which is exactly how the mutual exclusion below decayed into a comment.
# The message is required, not just the failure. Any command can fail -- a typo in a patch name, a
# missing bundle, a Gradle hiccup -- and all of those would light this lane green while the thing it
# guards quietly stopped working. It has to fail *for the stated reason*.
lane_must_fail() {
    name=$1
    expected=$2
    shift 2
    printf '\n=== %s ===\n' "$name"
    # Guarded by `if`, because a bare `out=$(...)` of a failing command exits the whole gate under
    # `set -e` -- which this lane runs into by construction, since it only ever runs failing things.
    if out=$("$@" 2>&1); then status=0; else status=$?; fi
    printf '%s\n' "$out" | tail -20
    if [ "$status" -eq 0 ]; then
        printf '  the command succeeded, and this lane exists because it must not\n'
        record "$name" FAIL
        failed=$((failed + 1))
    elif ! printf '%s' "$out" | grep -qF "$expected"; then
        printf '  it failed, but not for the stated reason: expected %s\n' "$expected"
        record "$name" FAIL
        failed=$((failed + 1))
    else
        record "$name" PASS
    fi
}

# A lane that fails with a stated reason and runs nothing. For configuration that was asked for and
# cannot be honoured -- which must not read as "not asked for".
fail_lane() {
    printf '\n=== %s ===\n  FAILED: %s\n' "$1" "$2"
    record "$1" "FAIL"
    failed=$((failed + 1))
}

skip() {
    printf '\n=== %s ===\n  SKIPPED: %s\n' "$1" "$2"
    record "$1" "SKIP"
    skipped=$((skipped + 1))
}

have_apk() { [ -e gboard.apk ] && [ -d gboard-apk ]; }

# Which interpreter is about to run seven of these lanes, and is it new enough.
#
# Not a pinned version: demanding an exact build means demanding that build be installed, and the
# floor is what the code actually needs. But the version is printed, because during one session
# this machine moved from 3.9.19 to 3.11.11 with nothing observing it -- the lanes simply started
# running on a different interpreter. CI runs whatever ubuntu-latest ships, which is newer again,
# so the two are never identical and the floor is the only thing both sides can agree on.
PYTHON_FLOOR="3.9"
python3 - "$PYTHON_FLOOR" <<'PYEOF' || exit 1
import sys
floor = tuple(int(part) for part in sys.argv[1].split("."))
if sys.version_info[:len(floor)] < floor:
    print(f"  python3 is {sys.version.split()[0]}, below the {sys.argv[1]} these scripts need")
    raise SystemExit(1)
print(f"python3 {sys.version.split()[0]}")
PYEOF

# First, because it is the only lane that tests the tooling rather than the APK, it needs nothing
# from the filesystem, and it runs in milliseconds. Every other lane here trusts code that this one
# checks: four defects in the register analysis and two dead rules in the emission linter all
# shipped while the lanes built on them reported PASS.
lane "unit tests"     python3 -m unittest discover -s tools/tests -t tools/tests -q
lane "compile"        ./gradlew :patches:compileKotlin :extension-check:compileJava -q
# The extension's own logic -- the blob parser, the label clamp, the icon resolution -- run on a
# desktop JVM. Everything above compiles it; nothing else has ever executed it, and the one bug we
# know shipped in that file was pure logic.
lane "extension"      ./gradlew :extension-check:extensionTests -q
# The patch helpers themselves. Every check in this gate reads Python or the APK; the patches were
# untested, and three shipped bugs lived in these helpers rather than in the APK reading.
lane "patch helpers"  ./gradlew :patches-check:run -q
# The eleven one-line delegates the helpers are reached through. No test covers them and none can:
# constructing a BytecodePatchContext needs an APK, which is why the helpers stopped taking one.
lane "delegates"      python3 .github/scripts/check_delegates.py
lane "constants"      python3 .github/scripts/check_shared_constants.py
lane "dex pins"       python3 .github/scripts/check_dex_pins.py
lane "emission lint"  python3 .github/scripts/check_emission_lint.py
# patches-list.json and the README table are generated, and only during a release -- so between
# releases the source can gain a patch or flip a default while both go on describing the old state.
lane "artifacts"      python3 .github/scripts/check_generated_artifacts.py

if have_apk; then
    lane "preflight" python3 tools/apk/preflight.py gboard-apk gboard.apk
else
    skip "preflight" "gboard.apk and/or gboard-apk/ absent — every dex and resource pin is unverified"
fi

# The only lane that executes the patches. Everything above inspects sources or the stock APK from
# the outside; this applies a real bundle to the real APK the way Morphe Manager does, so a
# patch-time failure surfaces here in a minute instead of after CI, an install and a phone.
#
# It needs a built .mpp, which needs the Android SDK, which is not here -- but CI attaches one to
# every release, so `gh release download` is enough. Point FLEXBOARD_BUNDLE at it. Deliberately
# opt-in rather than auto-downloading: a gate lane that reaches the network is a gate lane that
# fails for reasons unrelated to the code.
#
# The bundle is a *build artifact*, so a stale one tests the code it was built from rather than the
# code in front of you. That is not a theoretical failure: this lane passed all session against the
# dev.2 bundle while the tree held a tightened guard the bundle knew nothing about, and only the
# real dev.3 bundle revealed it. The version is checked against gradle.properties for that reason.
#
# Resolved before anything else, because "set but unusable" used to read as "not set": every bundle
# lane skipped with "set FLEXBOARD_BUNDLE", and the gate exited 0. The documented form was one of the
# unusable ones -- `FLEXBOARD_BUNDLE=/tmp/mpp/patches-*.mpp tools/gate` does not expand the glob,
# because an assignment never does, so the asterisk arrived intact and matched nothing. The loop
# below expands it (word-splitting and globbing on purpose) and insists on exactly one match.
bundle_error=""
if [ -n "${FLEXBOARD_BUNDLE:-}" ]; then
    matches=0
    match=""
    for candidate in $FLEXBOARD_BUNDLE; do
        if [ -e "$candidate" ]; then
            matches=$((matches + 1))
            match=$candidate
        fi
    done
    if [ "$matches" -ne 1 ]; then
        bundle_error="FLEXBOARD_BUNDLE=$FLEXBOARD_BUNDLE matches $matches file(s); point it at exactly one .mpp"
    elif ! have_apk; then
        stale_reason="gboard.apk and gboard-apk/ are needed to apply a bundle, and are not here"
    else
        FLEXBOARD_BUNDLE="$(cd "$(dirname "$match")" && pwd)/$(basename "$match")"
        patched_out="$(mktemp -d)/patched.apk"
        apk_path="$(python3 -c "import os;print(os.path.realpath('gboard.apk'))")"

        # Version, build time against the last commit touching the patch sources, and whether those
        # sources are even committed. The filename was the first attempt and was not enough: two
        # bundles can both be called 2.5.0-dev.3 and differ by every commit in between.
        if freshness=$(python3 tools/bundle_freshness.py "$FLEXBOARD_BUNDLE" 2>&1); then
            printf '%s\n' "$freshness"
            bundle_ready=1
        else
            printf '%s\n' "$freshness"
            case "$freshness" in
                # A crash is not staleness. It used to become a SKIP like any other exit 1.
                *Traceback*) bundle_error="tools/bundle_freshness.py crashed; its output is above" ;;
                *) stale_reason="$(printf '%s' "$freshness" | sed -n '1s/^ *//p')" ;;
            esac
        fi
    fi
fi

if [ "${bundle_ready:-0}" = 1 ]; then
    # Three runs, because one is a lie. The driver applies the default selection; the two swipe-up
    # patches ship default-off and are mutually exclusive, so they get a run each alongside the
    # defaults. Applying all fifteen at once -- what this did until dev.3 -- is a combination no
    # install can produce, and it fails on a guard behaving correctly.
    lane "driver" ./gradlew :driver:run -q \
        --args="$apk_path $FLEXBOARD_BUNDLE $patched_out"
    undo_out="$(mktemp -d)/undo.apk"
    lane "driver +undo" ./gradlew :driver:run -q \
        --args="$apk_path $FLEXBOARD_BUNDLE $undo_out +Swipe up to undo autocorrect"
    probe_out="$(mktemp -d)/probe.apk"
    lane "driver +probe" ./gradlew :driver:run -q \
        --args="$apk_path $FLEXBOARD_BUNDLE $probe_out +Swipe up diagnostic (temporary)"
    # The third default-off patch. Nothing selects it either, so without a run of its own it is
    # applied by no lane at all -- which it was, between narrowing the driver to defaults and now.
    lane "driver +hidden" ./gradlew :driver:run -q \
        --args="$apk_path $FLEXBOARD_BUNDLE $(mktemp -d)/hidden.apk +Hidden Features (unconfirmed)"

    # And the pair must now apply together. They used to share anchors in the key pipeline and
    # refuse each other; the diagnostic moved to the motion-event-handler layer (the scrub engine's
    # g), where it observes without claiming, so the two no longer touch the same method. This lane
    # used to assert the refusal. It now asserts the opposite, because a guard left over from the old
    # arrangement would silently stop one of them applying when both are selected.
    lane "driver +both" ./gradlew :driver:run -q \
        --args="$apk_path $FLEXBOARD_BUNDLE $(mktemp -d)/both.apk +Swipe up to undo autocorrect +Swipe up diagnostic (temporary)"

    # The driver proves the patches *apply*. It writes a dex and never loads one, so a method ART
    # would reject at class load passes it without complaint -- that is exactly what shipped twice.
    # This reads the output and checks every method the patch changed, which on this bundle is
    # seventeen and takes a couple of seconds.
    if [ -e "$patched_out" ]; then
        lane "verify" python3 tools/apk/verify.py "$patched_out" --changed-from gboard-apk
    else
        skip "verify" "the driver produced no APK, so there is nothing to check"
    fi

    # And the undo build, which is the emission that most needs it: the newest, the largest, and
    # the one whose two previous attempts shipped a keyboard that would not open.
    #
    # It needs saying because it was briefly lost. Narrowing the driver to the default selection was
    # right, but `verify` only ever read the defaults build -- and both swipe-up patches are
    # default-off, so the riskiest injection in the project silently stopped being checked by the
    # only thing here that approximates what ART rejects at class load. No gate output changed when
    # that happened, which is the whole problem with it.
    if [ -e "$undo_out" ]; then
        lane "verify +undo" python3 tools/apk/verify.py "$undo_out" --changed-from gboard-apk
    else
        skip "verify +undo" "the +undo driver run produced no APK"
    fi

    # And that each opt-in patch changed anything at all. `verify` checks what was emitted; it
    # cannot notice that nothing was, and an emission that produces nothing applies cleanly and
    # passes every other lane -- `2.5.0-dev.1` was exactly that, byte-identical to the build it
    # claimed to fix. Diffing each opt-in build against the defaults build of the same bundle
    # removes that: identical means the patch did nothing.
    if [ -e "$undo_out" ] && [ -e "$patched_out" ]; then
        lane "undo emits" python3 tools/apk/verify.py "$undo_out" --differs-from "$patched_out"
    else
        skip "undo emits" "needs both the defaults and the +undo build"
    fi
    if [ -e "$probe_out" ] && [ -e "$patched_out" ]; then
        lane "probe emits" python3 tools/apk/verify.py "$probe_out" --differs-from "$patched_out"
        # The diagnostic is what is on a device right now, so its one emission gets the same
        # type and reference check as the undo patch's -- including that FlickProbe.observe
        # resolves in the merged extension.
        lane "verify +probe" python3 tools/apk/verify.py "$probe_out" --changed-from gboard-apk
    else
        skip "probe emits" "needs both the defaults and the +probe build"
        skip "verify +probe" "the +probe driver run produced no APK"
    fi
elif [ -n "${bundle_error:-}" ]; then
    # Asked for and unusable: one lane fails so the gate does, and the rest say why they did not run.
    fail_lane "bundle" "$bundle_error"
    for name in "driver" "driver +undo" "driver +probe" "driver +hidden" "driver +both" \
                "verify" "verify +undo" "undo emits" "probe emits" "verify +probe"; do
        skip "$name" "FLEXBOARD_BUNDLE is set but unusable"
    done
elif [ -n "${stale_reason:-}" ]; then
    skip "driver" "$stale_reason"
    skip "driver +undo" "$stale_reason"
    skip "driver +probe" "$stale_reason"
    skip "driver +hidden" "$stale_reason"
    skip "driver +both" "$stale_reason"
    skip "verify" "needs a bundle built from this tree"
    skip "verify +undo" "needs a bundle built from this tree"
    skip "undo emits" "needs a bundle built from this tree"
    skip "probe emits" "needs a bundle built from this tree"
    skip "verify +probe" "needs a bundle built from this tree"
else
    skip "driver" "set FLEXBOARD_BUNDLE to a built .mpp to execute the patches (gh run download --name patches-bundle)"
    skip "driver +undo" "set FLEXBOARD_BUNDLE to a built .mpp"
    skip "driver +probe" "set FLEXBOARD_BUNDLE to a built .mpp"
    skip "driver +hidden" "set FLEXBOARD_BUNDLE to a built .mpp"
    skip "driver +both" "set FLEXBOARD_BUNDLE to a built .mpp"
    skip "verify" "needs the driver's output; set FLEXBOARD_BUNDLE"
    skip "verify +undo" "needs the driver's output; set FLEXBOARD_BUNDLE"
    skip "undo emits" "needs the driver's output; set FLEXBOARD_BUNDLE"
    skip "probe emits" "needs the driver's output; set FLEXBOARD_BUNDLE"
    skip "verify +probe" "needs the driver's output; set FLEXBOARD_BUNDLE"
fi

if [ "$run_resources" -eq 0 ]; then
    skip "resources" "--no-resources given — nothing checked what the bundle actually writes"
elif have_apk; then
    lane "resources" python3 tools/apk/check_patch_resources.py gboard.apk
else
    skip "resources" "gboard.apk absent — the resource replay and table rebuild cannot run"
fi

printf '\n===== gate =====\n'
printf "$results" | while IFS="$(printf '\t')" read -r name status; do
    printf '  %-16s %s\n' "$name" "$status"
done

if [ "$skipped" -gt 0 ]; then
    printf '\n  %s lane(s) SKIPPED. A skipped lane is not a passed lane: the checks that need the\n' "$skipped"
    printf '  Gboard APK are the whole defence against a bump, and the resource lane is the only\n'
    printf '  one that sees the patched output at all.\n'
fi

if [ "$failed" -gt 0 ]; then
    printf '\n  %s lane(s) FAILED.\n' "$failed"
    exit 1
fi

printf '\n  all run lanes passed\n'
